# ===========================================
# نورمهر - Frontend Environment (کامل)
# ===========================================
# کپی کن به .env.development و در صورت نیاز مقادیر را عوض کن.
# فقط متغیرهای با پیشوند VITE_ در فرانت در دسترس هستند.

# آدرس پایهٔ API (بک‌اند)
# خالی = استفاده از پروکسی Vite (همان دامنه، درخواست‌ها به سرور dev فرستاده می‌شوند)
# اگر خالی بگذاری، در فرانت از /api استفاده می‌شود و Vite همان را به backend پروکسی می‌کند.
# برای اتصال مستقیم به بک‌اند: http://localhost:5000 (بدون /api در انتها؛ در کد /api اضافه می‌شود)
VITE_API_BASE_URL=

# Google OAuth (ورود با گوگل) - باید با GOOGLE_CLIENT_ID در backend یکسان باشد
VITE_GOOGLE_CLIENT_ID=

# اختیاری: نام/عنوان سایت برای استفاده در فرانت
# VITE_APP_TITLE=نورمهر
